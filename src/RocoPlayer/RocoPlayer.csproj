<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <StartupObject>RocoPlayer.Program</StartupObject>
    <ApplicationIcon>Assets/icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets/audio/handpan/v2/*.wav" LogicalName="RocoPlayer.Handpan.v2.%(Filename).wav" />
    <EmbeddedResource Include="../../scripts/packaging/dd-package-hashes.json" LogicalName="RocoPlayer.DdPackageHashes.json" />
    <InternalsVisibleTo Include="DesktopChecks" />
    <PackageReference Include="HtmlAgilityPack" Version="1.13.1" />
    <PackageReference Include="NAudio.Vorbis" Version="1.5.0" />
    <PackageReference Include="NAudio" GeneratePathProperty="true" Version="2.2.1" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" GeneratePathProperty="true" Version="1.22.1" />
    <Content Include="Assets/models/basic-pitch/*" Link="models/basic-pitch/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(PkgNAudio)/license.txt" Link="licenses/NAudio.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(PkgMicrosoft_ML_OnnxRuntime)/LICENSE;$(PkgMicrosoft_ML_OnnxRuntime)/ThirdPartyNotices.txt" Link="licenses/ONNXRuntime/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(NetCoreRoot)LICENSE.txt;$(NetCoreRoot)ThirdPartyNotices.txt" Link="licenses/dotnet/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(NuGetPackageRoot)/nvorbis/0.10.4/LICENSE" Link="licenses/NVorbis.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../LICENSE;../../docs/THIRD_PARTY_NOTICES.md" Link="licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
