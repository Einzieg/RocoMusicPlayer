<Window x:Class="RocoPlayer.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:RocoPlayer" Title="RocoPlayer · 九键乐器播放器"
 Width="1080" Height="720" MinWidth="860" MinHeight="600" Background="#F8F8F1" Foreground="#253E34"
 FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen"
 UseLayoutRounding="True" PreviewKeyDown="WindowKeyDown">
 <Window.Resources><ResourceDictionary Source="MossTheme.xaml"/></Window.Resources>
 <Grid x:Name="Surface" Background="{StaticResource Paper}">
  <Grid x:Name="Shell">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border x:Name="Header" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1">
    <Grid Height="62" Margin="24,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Button x:Name="CaptureButton" Click="CaptureClick" Content="捕获游戏窗口" MaxWidth="248" VerticalAlignment="Center"
       Background="#E6EEE2" Foreground="{StaticResource Accent}" FontWeight="SemiBold" Padding="11,8"
       AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}" ToolTip="点击后，在 3 秒内切换到游戏窗口">
      <Button.ContentTemplate><DataTemplate><Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Path Margin="0,0,7,0" VerticalAlignment="Center" Stroke="{StaticResource Accent}" StrokeThickness="1.3"
         Data="M7,0 V4 M7,10 V14 M0,7 H4 M10,7 H14 M11,7 A4,4 0 1 1 3,7 A4,4 0 1 1 11,7 M8,7 A1,1 0 1 1 6,7 A1,1 0 1 1 8,7"/>
       <TextBlock Grid.Column="1" Text="{Binding}" TextTrimming="CharacterEllipsis"/>
      </Grid></DataTemplate></Button.ContentTemplate>
     </Button>
     <StackPanel x:Name="Navigation" Grid.Column="1" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
      <RadioButton Style="{StaticResource NavTab}" Content="我的谱库" GroupName="Nav" IsChecked="{Binding IsSelected,ElementName=LibraryTab,Mode=TwoWay}"/>
      <RadioButton Style="{StaticResource NavTab}" Content="在线下载" GroupName="Nav" IsChecked="{Binding IsSelected,ElementName=OnlineTab,Mode=TwoWay}"/>
      <RadioButton Style="{StaticResource NavTab}" Content="音频转谱" GroupName="Nav" IsChecked="{Binding IsSelected,ElementName=AudioTab,Mode=TwoWay}"/>
      <RadioButton Style="{StaticResource NavTab}" Content="应用设置" GroupName="Nav" IsChecked="{Binding IsSelected,ElementName=SettingsTab,Mode=TwoWay}"/>
     </StackPanel>
     <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
      <Path Data="M2,12 L4,20 M8,4 L11,19 M15,7 L17,15" Stroke="{StaticResource Ink}" StrokeThickness="3.6"
       StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <TextBlock Text="RocoPlayer" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="18"/>
     </StackPanel>
    </Grid>
   </Border>
   <TabControl x:Name="Pages" Grid.Row="1" SelectedIndex="0" Background="{StaticResource Paper}" SelectionChanged="PageChanged">
    <TabControl.Template><ControlTemplate TargetType="TabControl">
     <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
    </ControlTemplate></TabControl.Template>
    <TabItem x:Name="LibraryTab" Header="我的谱库"><Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="44*"/><ColumnDefinition Width="56*"/></Grid.ColumnDefinitions>
     <Grid x:Name="LibraryBrowser" Margin="28,22,28,14">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel LastChildFill="True">
       <Button DockPanel.Dock="Right" x:Name="AddNotationButton" Content="＋ 添加简谱" Style="{StaticResource Primary}" Click="AddTextClick" VerticalAlignment="Center" AutomationProperties.Name="添加简谱"/>
       <Button DockPanel.Dock="Right" Content="导入文件" Style="{StaticResource Quiet}" Margin="0,0,6,0" Padding="8,7"
        ToolTip="导入本地 TXT 或 MIDI 文件" Click="ImportClick" VerticalAlignment="Center"/>
       <TextBlock Text="本地谱库" Style="{StaticResource Heading}" Margin="0" VerticalAlignment="Center"/>
      </DockPanel>
      <Grid Grid.Row="1" Margin="0,16,0,10">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Border Background="#FCFCF7" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="6" Margin="0,0,12,0">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <Path Data="M10,5 A5,5 0 1 1 0,5 A5,5 0 1 1 10,5 M8.7,8.7 L13,13" Stroke="{StaticResource Muted}"
           StrokeThickness="1.35" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" IsHitTestVisible="False"/>
         <TextBox x:Name="Filter" Grid.Column="1" AutomationProperties.Name="搜索本地曲谱" ToolTip="按曲名或来源搜索（Ctrl+F）"
           Background="Transparent" BorderThickness="0" Padding="2,4" Margin="0" TextChanged="FilterChanged"/>
         <TextBlock Grid.Column="1" IsHitTestVisible="False" VerticalAlignment="Center" Margin="3,0" Text="搜索本地曲谱" Foreground="{StaticResource Muted}" FontSize="13">
          <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
           <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Filter}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
          </Style></TextBlock.Style>
         </TextBlock>
         <Button x:Name="ClearSearch" Grid.Column="2" Click="ClearSearchClick" Content="×" FontSize="16" Padding="7,0" ToolTip="清除搜索" AutomationProperties.Name="清除搜索">
          <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Quiet}"><Style.Triggers>
           <DataTrigger Binding="{Binding Text, ElementName=Filter}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
          </Style.Triggers></Style></Button.Style>
         </Button>
        </Grid>
       </Border>
       <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Style="{StaticResource Caption}" Text="排序" Margin="0,0,6,0" VerticalAlignment="Center"/>
        <ComboBox x:Name="SortOrder" MinWidth="100" Margin="0" Padding="6,4" FontSize="13" SelectedIndex="0"
         AutomationProperties.Name="曲谱排序" SelectionChanged="SortChanged"><ComboBoxItem Content="下载顺序"/><ComboBoxItem Content="曲谱名称"/></ComboBox>
       </StackPanel>
      </Grid>
      <Grid Grid.Row="2" Margin="12,0,12,5">
       <TextBlock x:Name="SongCount" Style="{StaticResource Caption}"/><TextBlock Text="时长" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
      </Grid>
      <Grid Grid.Row="3">
       <ListBox x:Name="Songs" ItemContainerStyle="{StaticResource LibraryItemStyle}" Background="Transparent" BorderThickness="0"
        Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.VirtualizationMode="Recycling"
        SelectionChanged="SongChanged" AutomationProperties.Name="本地曲谱列表"><ListBox.ItemTemplate><DataTemplate>
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,10,0"><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="15" ToolTip="{Binding Title}"/>
           <TextBlock Text="{Binding SourceLabel}" Style="{StaticResource Caption}" FontWeight="Normal" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding DurationLabel}" FontWeight="Normal" Style="{StaticResource Time}"/>
         </Grid>
        </DataTemplate></ListBox.ItemTemplate></ListBox>
       <TextBlock x:Name="EmptyResults" Style="{StaticResource Hint}" TextAlignment="Center" Margin="10,40,10,0" VerticalAlignment="Top" IsHitTestVisible="False"/>
      </Grid>
     </Grid>
     <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Stroke}" BorderThickness="1,0,0,0">
      <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <Grid MinHeight="{Binding ViewportHeight, ElementName=DetailScroll}">
        <Grid Margin="24,20,24,12">
         <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition MinHeight="145"/>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,8,0">
           <TextBlock Text="当前选择" Style="{StaticResource Caption}"/>
           <TextBlock x:Name="SongTitle" FontFamily="Georgia, STZhongsong, SimSun" FontSize="30" FontWeight="Bold" Margin="0,2,0,0"
            TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
           <TextBlock x:Name="SongMeta" Style="{StaticResource Caption}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <Button Grid.Column="1" x:Name="ExportButton" Content="导出九键 MIDI" Click="ExportClick" Padding="10,6" FontSize="12" VerticalAlignment="Center"/>
         </Grid>
         <Border Grid.Row="1" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1" Margin="0,15,0,0">
          <DockPanel><TextBlock DockPanel.Dock="Right" Text="时间轴 · 秒" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
           <StackPanel x:Name="Versions" Orientation="Horizontal">
            <RadioButton x:Name="ArrangedVersion" Content="9 键谱" Style="{StaticResource NavTab}" Padding="3,7" Margin="0,0,16,0"
             GroupName="Version" IsChecked="True" Checked="NoteVersionChanged"/>
            <RadioButton x:Name="OriginalVersion" Content="原始音符" Style="{StaticResource NavTab}" Padding="3,7"
             GroupName="Version" Checked="NoteVersionChanged"/>
           </StackPanel>
          </DockPanel>
         </Border>
         <Grid Grid.Row="2" Margin="0,12,0,12"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <local:NoteTimeline x:Name="NoteRoll" ClipToBounds="True" AutomationProperties.Name="音符时间轴"/>
          <Grid Grid.Row="1" Margin="28,5,0,0"><TextBlock Text="00:00" Style="{StaticResource Time}"/>
           <TextBlock x:Name="RollMiddle" Style="{StaticResource Time}" HorizontalAlignment="Center"/>
           <TextBlock x:Name="RollEnd" Style="{StaticResource Time}" HorizontalAlignment="Right"/></Grid>
         </Grid>
         <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Stroke}" Padding="0,12,0,0">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
           <StackPanel><TextBlock Text="原始音符" Style="{StaticResource Caption}"/><TextBlock x:Name="OriginalCount" Style="{StaticResource Metric}"/></StackPanel>
           <TextBlock Grid.Column="1" Text="→" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,14,0"/>
           <StackPanel Grid.Column="2"><TextBlock Text="适配后音符" Style="{StaticResource Caption}"/>
            <TextBlock x:Name="FittedCount" Style="{StaticResource Metric}" Foreground="{StaticResource Accent}"/></StackPanel>
           <StackPanel Grid.Column="3"><TextBlock Text="目标键位" Style="{StaticResource Caption}"/><TextBlock x:Name="TargetKeys" Style="{StaticResource Metric}"/></StackPanel>
          </Grid>
         </Border>
         <DockPanel Grid.Row="4" Margin="0,6,0,0" LastChildFill="False">
          <Button x:Name="SourceListen" Content="试听原音频" Click="AuditionClick" Style="{StaticResource Quiet}" FontSize="12" Padding="0,4"/>
          <Button DockPanel.Dock="Right" x:Name="RemoveScore" Content="删除曲谱" Click="DeleteClick" Style="{StaticResource Quiet}" FontSize="12" Padding="4"/>
         </DockPanel>
        </Grid>
       </Grid>
      </ScrollViewer>
     </Border>
    </Grid></TabItem>
    <TabItem x:Name="OnlineTab" Header="在线下载">
     <Grid x:Name="OnlineBody" Margin="30,24,30,16">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="在线下载" Style="{StaticResource Heading}"/>
      <Grid Grid.Row="1" Margin="0,0,0,12">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="RocoMusic 公开曲谱" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
       <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Grid Width="215"><TextBox x:Name="Query" MaxLength="100" Margin="0,0,6,0" KeyDown="QueryKeyDown" AutomationProperties.Name="在线曲名或作者"/>
         <TextBlock Text="搜索曲名或作者" IsHitTestVisible="False" Margin="10,0" VerticalAlignment="Center">
          <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Setter Property="Visibility" Value="Collapsed"/>
           <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Query}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
          </Style></TextBlock.Style>
         </TextBlock>
        </Grid>
        <Button Content="搜索" Click="SearchClick" Style="{StaticResource Primary}"/>
       </StackPanel>
      </Grid>
      <Grid Grid.Row="2">
       <ListBox x:Name="OnlineList" Background="Transparent" BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource LibraryItemStyle}"
        ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="在线曲谱列表">
        <ListBox.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1" Padding="0,5,0,12">
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,16,0"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="17" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
           <WrapPanel Margin="0,3,0,0"><TextBlock Text="{Binding Format}" Style="{StaticResource Caption}" Margin="0,0,8,0"/>
            <TextBlock Text="{Binding Author}" Style="{StaticResource Caption}"/></WrapPanel>
           <TextBlock Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Subtitle}">
            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Style.Triggers>
             <DataTrigger Binding="{Binding Subtitle}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
            </Style.Triggers></Style></TextBlock.Style>
           </TextBlock>
          </StackPanel>
          <Button Grid.Column="1" Content="下载" Click="DownloadClick" ToolTip="下载到我的谱库" AutomationProperties.Name="下载到我的谱库"
           VerticalAlignment="Center" Background="#E6EEE2" Foreground="{StaticResource Accent}"/>
         </Grid>
        </Border></DataTemplate></ListBox.ItemTemplate>
       </ListBox>
       <TextBlock x:Name="OnlineEmpty" Style="{StaticResource Hint}" Text="输入曲名或作者搜索曲谱" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,36" IsHitTestVisible="False"/>
      </Grid>
      <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
       <Button Content="上一页" x:Name="PrevPage" IsEnabled="False" Click="OnlinePrevClick"/>
       <TextBlock x:Name="PageNumber" Style="{StaticResource Caption}" Margin="12,0" VerticalAlignment="Center"/>
       <Button Content="下一页" x:Name="NextPage" IsEnabled="False" Click="OnlineNextClick"/>
      </StackPanel>
     </Grid>
    </TabItem>
    <TabItem x:Name="AudioTab" Header="音频转谱"><ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel x:Name="AudioBody" Margin="30,24" MaxWidth="820" HorizontalAlignment="Left">
      <TextBlock Text="音频转谱" Style="{StaticResource Heading}"/>
      <TextBlock Text="本地音频" Style="{StaticResource Caption}" Margin="0,8,0,4"/>
      <DockPanel><Button Content="选择音频…" DockPanel.Dock="Right" VerticalAlignment="Center" Click="AudioFileClick"/>
       <TextBlock x:Name="AudioPath" Text="尚未选择音频文件" TextTrimming="CharacterEllipsis" FontSize="21" FontWeight="SemiBold" Margin="0,0,16,0" VerticalAlignment="Center"/>
      </DockPanel>
      <TextBlock Text="支持 WAV、MP3、FLAC、OGG，时长 0.1 至 300 秒。" Style="{StaticResource Hint}"/>
      <Border Style="{StaticResource Rule}"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="22"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="识别引擎" Style="{StaticResource Field}"/><ComboBox x:Name="Engine" SelectionChanged="EngineChanged" Width="252" AutomationProperties.Name="识别引擎"/></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="主奏音区" Style="{StaticResource Field}"/><ComboBox x:Name="Register" Width="160" AutomationProperties.Name="主奏音区"/></StackPanel>
      </Grid>
      <CheckBox x:Name="KeepChords" Content="保留和弦（实验）" Margin="0,14,0,20"/>
      <Button Content="转谱并加入谱库" Click="TranscribeClick" HorizontalAlignment="Left" Style="{StaticResource Primary}"/>
     </StackPanel>
    </ScrollViewer></TabItem>
    <TabItem x:Name="SettingsTab" Header="应用设置"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="SettingsBody" Margin="30,24">
     <DockPanel><Button Content="保存设置" DockPanel.Dock="Right" Click="SaveSettingsClick" VerticalAlignment="Center" Style="{StaticResource Primary}"/>
      <TextBlock Text="应用设置" Style="{StaticResource Heading}" Margin="0"/></DockPanel>
     <TextBlock Text="演奏" Style="{StaticResource Subhead}"/>
     <WrapPanel><StackPanel Width="145"><TextBlock Text="播放顺序" Style="{StaticResource Caption}"/><ComboBox x:Name="ModeBox" SelectionChanged="ModeChanged" AutomationProperties.Name="播放顺序"/></StackPanel>
      <StackPanel Width="116"><TextBlock Text="速度倍率" Style="{StaticResource Caption}"/><TextBox x:Name="Speed" AutomationProperties.Name="速度倍率"/></StackPanel>
      <StackPanel Width="132"><TextBlock Text="按键时长（ms）" Style="{StaticResource Caption}"/><TextBox x:Name="Hold" AutomationProperties.Name="按键时长"/></StackPanel>
      <StackPanel Width="112"><TextBlock Text="延迟（秒）" Style="{StaticResource Caption}"/><TextBox x:Name="Delay" AutomationProperties.Name="延迟"/></StackPanel>
      <StackPanel Width="120"><TextBlock Text="输入后端" Style="{StaticResource Caption}"/><ComboBox x:Name="Backend" AutomationProperties.Name="输入后端"/></StackPanel>
     </WrapPanel>
     <CheckBox x:Name="AutoCompact" Content="真实演奏时进入置顶小窗" IsChecked="True" Margin="0,9,0,1"/>
     <CheckBox x:Name="SilentPreview" Content="无按键预览" Margin="0,6,0,1" IsChecked="False" Checked="PreviewChanged" Unchecked="PreviewChanged" ToolTip="本次运行只预览演奏进度"/>
     <Border Style="{StaticResource Rule}"/>
     <TextBlock Text="简谱与键位" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,7"/>
     <WrapPanel><TextBlock Text="简谱 BPM" Style="{StaticResource Field}"/><TextBox x:Name="Bpm" Width="68" AutomationProperties.Name="简谱 BPM"/>
      <TextBlock Text="简谱八度" Style="{StaticResource Field}" Margin="12,0,7,0"/><TextBox x:Name="Octave" Width="68" AutomationProperties.Name="简谱八度"/></WrapPanel>
     <TextBlock Text="九键映射" Style="{StaticResource Caption}" Margin="0,9,0,1"/>
     <ItemsControl x:Name="Mappings"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate><StackPanel Width="62"><TextBox Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" MaxLength="1" ToolTip="演奏键"/>
       <TextBox Text="{Binding Pitch, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" MaxLength="3" ToolTip="MIDI 音高"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
     <TextBlock Text="上行为键盘字母或数字，下行为 MIDI 音高（C4 = 60）。" Style="{StaticResource Hint}"/>
     <Border Style="{StaticResource Rule}"/>
     <TextBlock Text="游戏窗口" FontSize="16" FontWeight="SemiBold"/>
     <TextBlock x:Name="TargetInfo" Text="尚未捕获" Style="{StaticResource Hint}"/>
     <WrapPanel><Button Content="实测九键音高…" Click="CalibrationClick" Margin="0,0,8,0"/><Button Content="DD 只读诊断" Click="DiagnosticsClick"/></WrapPanel>
    </StackPanel></ScrollViewer></TabItem>
   </TabControl>
   <Grid x:Name="CompactPanel" Grid.Row="1" Background="{StaticResource PlayerSurface}" Visibility="Collapsed">
    <Grid Margin="14,5"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="20"/><RowDefinition Height="20"/></Grid.RowDefinitions>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Text, ElementName=BarTitle}" ToolTip="{Binding Text, ElementName=BarTitle}"
       Style="{StaticResource TrackTitle}" Margin="0,0,8,0"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
       <Button Style="{StaticResource CompactControl}" Width="42" Click="PreviousClick" IsEnabled="{Binding IsEnabled, ElementName=PreviousButton}" ToolTip="上一首" AutomationProperties.Name="上一首">
        <Path Data="{StaticResource PreviousGlyph}" Style="{StaticResource CompactGlyph}"/></Button>
       <Button x:Name="CompactPlay" Click="PlayToggleClick" Style="{StaticResource CompactControl}" Width="44" Height="44" Margin="12,0"
        Background="{StaticResource Accent}" Foreground="White" ToolTip="{Binding ToolTip, ElementName=PlayButton}" AutomationProperties.Name="{Binding Text, ElementName=PlayLabel}">
        <Path Data="{Binding Data, ElementName=PlayIcon}" Style="{StaticResource CompactGlyph}" Width="17" Height="20" Stretch="Uniform"
         StrokeThickness="{Binding StrokeThickness, ElementName=PlayIcon}"/></Button>
       <Button Style="{StaticResource CompactControl}" Width="42" Click="NextClick" IsEnabled="{Binding IsEnabled, ElementName=NextButton}" ToolTip="下一首" AutomationProperties.Name="下一首">
        <Path Data="{StaticResource NextGlyph}" Style="{StaticResource CompactGlyph}"/></Button>
       <Button Style="{StaticResource CompactControl}" Width="38" Click="StopClick" ToolTip="停止（F10）" AutomationProperties.Name="停止">
        <Path Data="{StaticResource StopGlyph}" Style="{StaticResource CompactGlyph}"/></Button>
      </StackPanel>
      <ComboBox x:Name="CompactMode" Grid.Column="2" SelectionChanged="ModeChanged" Margin="8,0,4,0" MinWidth="91" FontSize="12" VerticalAlignment="Center"
       ToolTip="播放模式" AutomationProperties.Name="播放模式"/>
      <Button x:Name="ExpandButton" Grid.Column="3" Style="{StaticResource CompactControl}" Foreground="{StaticResource Muted}" Click="CompactClick" VerticalAlignment="Center" ToolTip="展开谱库" AutomationProperties.Name="展开谱库">
       <Path Data="M3,2 H1 V14 H14 V11 M6,9 L14,1 M8,1 H14 V7" Style="{StaticResource CompactGlyph}"/></Button>
     </Grid>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Text, ElementName=Elapsed}" Style="{StaticResource Time}"/>
      <ProgressBar x:Name="CompactProgress" Grid.Column="1" Height="4" Margin="8,0" VerticalAlignment="Center"
       Maximum="{Binding Maximum, ElementName=Seek}" Value="{Binding Value, ElementName=Seek, Mode=OneWay}" AutomationProperties.Name="演奏进度">
       <ProgressBar.Template><ControlTemplate TargetType="ProgressBar"><Border x:Name="PART_Track" Background="{StaticResource Stroke}" CornerRadius="2">
        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{StaticResource Accent}" CornerRadius="2"/></Border></ControlTemplate></ProgressBar.Template>
      </ProgressBar>
      <TextBlock Grid.Column="2" Text="{Binding Text, ElementName=TrackDuration}" Style="{StaticResource Time}"/>
     </Grid>
     <TextBlock Grid.Row="2" Text="{Binding Text, ElementName=Status}" ToolTip="{Binding Text, ElementName=Status}"
      Style="{StaticResource Caption}" VerticalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
    </Grid>
   </Grid>
   <StackPanel x:Name="Footer" Grid.Row="2">
    <Border x:Name="PlayerBar" Background="{StaticResource PlayerSurface}" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0" Padding="22,8,22,1">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <TextBlock x:Name="BarTitle" Style="{StaticResource TrackTitle}" Margin="0,0,14,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
       <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="PreviousButton" Style="{StaticResource Transport}" Click="PreviousClick" ToolTip="上一首" AutomationProperties.Name="上一首">
         <Path Data="{StaticResource PreviousGlyph}" Stroke="{StaticResource Ink}" StrokeThickness="1.4"/></Button>
        <Button x:Name="PlayButton" Style="{StaticResource Primary}" Click="PlayToggleClick" Margin="3,0" Padding="11,6" MinHeight="38"
         AutomationProperties.Name="{Binding Text, ElementName=PlayLabel}">
         <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Path x:Name="PlayIcon" Stroke="White" Height="14" Stretch="Uniform" StrokeThickness="1.6" VerticalAlignment="Center"/>
          <TextBlock x:Name="PlayLabel" Margin="7,0,0,0" VerticalAlignment="Center"/>
         </StackPanel>
        </Button>
        <Button x:Name="NextButton" Style="{StaticResource Transport}" Click="NextClick" ToolTip="下一首" AutomationProperties.Name="下一首">
         <Path Data="{StaticResource NextGlyph}" Stroke="{StaticResource Ink}" StrokeThickness="1.4"/></Button>
        <Button x:Name="StopButton" Style="{StaticResource Transport}" Click="StopClick" ToolTip="停止（F10）" AutomationProperties.Name="停止">
         <Path Data="{StaticResource StopGlyph}" Stroke="{StaticResource Ink}" StrokeThickness="1.4"/></Button>
       </StackPanel>
       <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button x:Name="ListenButton" Click="AuditionClick" Content="试听" Margin="10,0,0,0" Padding="12,8" Background="Transparent"
         Foreground="{StaticResource Accent}" FontWeight="SemiBold" AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}">
         <Button.ContentTemplate><DataTemplate><StackPanel Orientation="Horizontal">
          <Path Data="M1,9 V7 A6,6 0 0 1 13,7 V9 M1,8 H4 V13 H1 Z M10,8 H13 V13 H10 Z" Stroke="{StaticResource Accent}"
           StrokeThickness="1.25" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="{Binding}"/>
         </StackPanel></DataTemplate></Button.ContentTemplate>
        </Button>
        <ComboBox x:Name="BarMode" SelectionChanged="ModeChanged" MinWidth="91" FontSize="12" Margin="8,0,2,0" VerticalAlignment="Center"
         ToolTip="播放模式" AutomationProperties.Name="播放模式"/>
        <Button x:Name="CompactEntry" Style="{StaticResource Quiet}" Click="CompactClick" Padding="6,4" ToolTip="置顶小窗" AutomationProperties.Name="置顶小窗">
         <Path Data="M1,1 H17 V14 H1 Z M9,7 H15 V12 H9 Z" Stroke="{StaticResource Muted}" StrokeThickness="1.4" StrokeLineJoin="Round"/></Button>
       </StackPanel>
      </Grid>
      <Grid Grid.Row="1" Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock x:Name="Elapsed" Text="00:00" Style="{StaticResource Time}"/>
       <Slider Grid.Column="1" x:Name="Seek" Style="{StaticResource SeekStyle}" Minimum="0" Maximum="1" Margin="10,0" SmallChange="1" LargeChange="5"
        IsMoveToPointEnabled="True" ValueChanged="SeekChanged" LostMouseCapture="SeekReleased" AutomationProperties.Name="播放进度" ToolTip="选择演奏或试听的起点"/>
       <TextBlock Grid.Column="2" x:Name="TrackDuration" Text="00:00" Style="{StaticResource Time}"/>
      </Grid>
     </Grid>
    </Border>
    <ProgressBar x:Name="Timeline" Visibility="Collapsed" Height="2" Maximum="100" Foreground="{StaticResource Accent}" Background="{StaticResource Stroke}" BorderThickness="0"/>
    <DockPanel Background="#FCFCF6" MinHeight="23">
     <Button x:Name="CancelJob" Content="取消任务" Visibility="Collapsed" Style="{StaticResource Quiet}" Click="StopClick" DockPanel.Dock="Right" FontSize="12" Padding="7,2"/>
     <TextBlock x:Name="Status" Text="就绪" Style="{StaticResource Caption}" Margin="22,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    </DockPanel>
   </StackPanel>
  </Grid>
  <Grid x:Name="TextEditor" Background="#66253E34" Visibility="Collapsed" KeyboardNavigation.TabNavigation="Cycle">
   <Border Width="490" Background="{StaticResource Paper}" Padding="26" CornerRadius="12" VerticalAlignment="Center">
    <StackPanel><TextBlock Text="添加简谱" Style="{StaticResource Heading}"/>
     <TextBlock Text="曲名" Style="{StaticResource Field}"/><TextBox x:Name="TextTitle" AutomationProperties.Name="曲名" MaxLength="300"/>
     <TextBlock Text="简谱" Style="{StaticResource Subhead}"/>
     <TextBlock Text="用空格分隔音符，0 表示休止，[3 5 7] 表示和弦。例：1 2 3:2 5" Style="{StaticResource Hint}"/>
     <TextBox x:Name="Notation" AutomationProperties.Name="简谱内容" Height="132" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="17"/>
     <TextBlock Text="{Binding Text, ElementName=Status}" Style="{StaticResource Hint}"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" Click="CloseTextClick" Margin="0,0,8,0"/>
      <Button x:Name="CommitText" Content="添加到谱库" Click="TextImportClick" Style="{StaticResource Primary}"/></StackPanel>
    </StackPanel>
   </Border>
  </Grid>
 </Grid>
</Window>
